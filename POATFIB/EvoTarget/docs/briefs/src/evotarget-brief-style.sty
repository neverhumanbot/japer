% Shared NEVERHUMAN Research editorial house style for EvoTarget-FT POAF briefs.
% Adapted directly from NEVERHUMAN Research's DOPE v3 2-page brief stylesheet
% (Bitstream Charter body, URW Nimbus Sans display, Latin Modern Mono code,
%  #D9480F house orange, #1E3A5F navy, #006D77 teal, #256ABF blue).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{evotarget-brief-style}[2026/11/25 EvoTarget-FT Executive & Technical Brief Style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{amsmath}
\RequirePackage{txfonts}
\RequirePackage{charter}
\RequirePackage[scaled=0.885]{helvet}
\renewcommand{\ttdefault}{lmtt}
\RequirePackage[italic,defaultmathsizes]{mathastext}
\makeatletter
\DeclareSymbolFontAlphabet{\mathrm}{mtoperatorfont}
\renewcommand{\operator@font}{\mathgroup\symmtoperatorfont}
\makeatother
\RequirePackage[protrusion=true,expansion=true,final]{microtype}
\DisableLigatures[-]{encoding = T1, family = tt*}

\RequirePackage[letterpaper,left=0.50in,right=0.50in,top=0.46in,bottom=0.48in,
                headheight=13pt,headsep=0.14in,footskip=0.24in]{geometry}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{array,booktabs,tabularx,makecell,multirow}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{xurl}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric}
\usepgfplotslibrary{fillbetween}
\RequirePackage{qrcode}
\RequirePackage{upquote}

% ---- NEVERHUMAN Research house palette --------------------------------------
\definecolor{ink}{HTML}{111827}
\definecolor{sub}{HTML}{4B5563}
\definecolor{muted}{HTML}{9CA3AF}
\definecolor{hair}{HTML}{D1D5DB}
\definecolor{gridline}{HTML}{E5E7EB}
\definecolor{surface}{HTML}{F3F4F6}
\definecolor{surfacealt}{HTML}{F9FAFB}
\definecolor{accent}{HTML}{D9480F}
\definecolor{accentdark}{HTML}{B53A0B}
\definecolor{accenttint}{HTML}{FDEBE1}
\definecolor{blue}{HTML}{256ABF}
\definecolor{bluetint}{HTML}{EEF3FA}
\definecolor{teal}{HTML}{006D77}
\definecolor{tealtint}{HTML}{EAF4F4}
\definecolor{navy}{HTML}{1E3A5F}
\definecolor{navytint}{HTML}{EDF1F7}
\definecolor{slate}{HTML}{64748B}
\definecolor{tierA}{HTML}{EDA17B}
\definecolor{codebg}{HTML}{0F172A}
\definecolor{codefg}{HTML}{F8FAFC}
\definecolor{codecomment}{HTML}{94A3B8}
\definecolor{codeaccent}{HTML}{FB923C}

\RequirePackage[colorlinks=true,linkcolor=accentdark,citecolor=blue,urlcolor=blue,
                pdfusetitle,bookmarks=false]{hyperref}
\urlstyle{same}

% ---- Typography rhythm ------------------------------------------------------
\linespread{1.03}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3pt}
\emergencystretch=1.2em
\raggedbottom
\clubpenalty=6000
\widowpenalty=6000
\setlist{leftmargin=1.18em,itemsep=1.5pt,topsep=1.5pt,parsep=0pt}

% ---- Helpers & macros -------------------------------------------------------
\newcommand{\wordmark}{EvoTarget\textcolor{accent}{-}FT}
\newcommand{\briefdate}{November 2026}
\newcommand{\repourl}{https://github.com/neverhumanbot/japer}
\newcommand{\repotext}{github.com/neverhumanbot/japer}
\newcommand{\x}{\ensuremath{\times}}
\newcommand{\m}{\ensuremath{-}}
\newcommand{\cli}[1]{{\ttfamily\fontsize{7.8}{9.6}\selectfont #1}}
\newcommand{\tcli}[1]{{\ttfamily\fontsize{6.8}{8.4}\selectfont #1}}
\newcommand{\eyebrow}[1]{{\sffamily\bfseries\fontsize{7.0}{8.6}\selectfont\color{accentdark}\MakeUppercase{#1}}}
\newcommand{\thd}[1]{{\sffamily\bfseries\fontsize{6.7}{8.1}\selectfont\color{ink}#1}}
\newcommand{\ftitlefont}{\sffamily\bfseries\fontsize{7.2}{8.6}\selectfont\color{ink}}
\newcommand{\fbodyfont}{\sffamily\fontsize{6.5}{8.1}\selectfont\color{sub}}
\newcommand{\fsfont}{\sffamily\fontsize{6.1}{7.4}\selectfont}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\setlength{\heavyrulewidth}{0.75pt}
\setlength{\lightrulewidth}{0.4pt}
\setlength{\aboverulesep}{1.7pt}
\setlength{\belowrulesep}{1.9pt}
\arrayrulecolor{ink}

% ---- Section headings -------------------------------------------------------
\newcommand{\briefsection}[2]{%
  \vspace{3.0pt}%
  \noindent{\sffamily\bfseries\fontsize{6.8}{8.2}\selectfont\color{accentdark}\MakeUppercase{#1}}%
  \hspace{0.5em}\textcolor{hair}{\rule[-0.14em]{0.6pt}{0.92em}}\hspace{0.5em}%
  {\sffamily\bfseries\fontsize{9.6}{11.5}\selectfont\color{ink}#2}\par
  \vspace{-2.5pt}%
  \noindent\textcolor{hair}{\rule{\linewidth}{0.45pt}}\par
  \vspace{2.5pt}%
}

\newcommand{\colheading}[1]{%
  \noindent{\sffamily\bfseries\fontsize{8.6}{10.4}\selectfont\color{ink}#1}\par
  \vspace{1.4pt}%
}

% ---- Running headers/footers ------------------------------------------------
\newcommand{\briefrunningtitle}{Executive Brief}
\fancypagestyle{briefpage1}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[L]{\sffamily\fontsize{6.5}{8.0}\selectfont\textcolor{sub}{NEVERHUMAN Research \& HonorHealth Heart Care \;\textbar\; \briefrunningtitle \;\textbar\; STS ACSD v2.81 (\briefdate)}}%
  \fancyfoot[R]{\sffamily\fontsize{6.5}{8.0}\selectfont\textcolor{sub}{Page 1 of 2}}%
}
\fancypagestyle{briefpage2}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0.45pt}%
  \renewcommand{\headrule}{\hbox to\headwidth{\color{hair}\leaders\hrule height \headrulewidth\hfill}}%
  \renewcommand{\footrulewidth}{0pt}%
  \fancyhead[L]{\sffamily\fontsize{7.0}{8.6}\selectfont\textcolor{ink}{\textbf{\wordmark}}\;\textcolor{sub}{\briefrunningtitle}}%
  \fancyhead[R]{\sffamily\fontsize{7.0}{8.6}\selectfont\textcolor{sub}{NEVERHUMAN Research \& HonorHealth \;\textbar\; STS CABG POAF Study}}%
  \fancyfoot[L]{\sffamily\fontsize{6.5}{8.0}\selectfont\textcolor{sub}{Pre-Incision POAF Research \;\textbar\; \href{\repourl}{\texttt{\repotext}}}}%
  \fancyfoot[R]{\sffamily\fontsize{6.5}{8.0}\selectfont\textcolor{sub}{Page 2 of 2}}%
}

% ---- Masthead Banner --------------------------------------------------------
\newcommand{\briefmasthead}[3]{%
  \vspace*{-0.18in}%
  \noindent\textcolor{accent}{\rule{\textwidth}{2.3pt}}\par
  \vspace{3.5pt}%
  \noindent
  \begin{minipage}[t]{0.74\textwidth}
    \vspace{0pt}\raggedright
    {\sffamily\bfseries\fontsize{7.0}{8.5}\selectfont\color{accentdark}\MakeUppercase{#1}}\par
    \vspace{2pt}
    {\sffamily\bfseries\fontsize{15.0}{17.4}\selectfont\color{ink}#2\par}
    \vspace{2pt}
    {\fontsize{8.85}{11.0}\selectfont\color{sub}#3\par}
  \end{minipage}\hfill
  \begin{minipage}[t]{0.24\textwidth}
    \vspace{0pt}\raggedleft
    {\sffamily\bfseries\fontsize{13.8}{15.0}\selectfont\color{ink}\wordmark}\par
    \vspace{1.2pt}
    {\sffamily\bfseries\fontsize{6.6}{8.0}\selectfont\color{navy}NEVERHUMAN RESEARCH}\par
    {\sffamily\fontsize{6.3}{7.8}\selectfont\color{teal}HonorHealth Heart Care}\par
    {\sffamily\fontsize{6.3}{7.8}\selectfont\color{sub}STS v2.81 \textbar{} \briefdate}\par
    {\sffamily\fontsize{6.0}{7.5}\selectfont\color{sub}\href{\repourl}{\texttt{japer/POATFIB/EvoTarget}}}%
  \end{minipage}\par
  \vspace{4pt}%
  \noindent\textcolor{hair}{\rule{\textwidth}{0.5pt}}\par
  \vspace{4pt}%
}

% ---- Hero KPI Card ----------------------------------------------------------
\newcommand{\kpicard}[4]{%
  \begin{tcolorbox}[enhanced,colback=surfacealt,colframe=hair,boxrule=0.45pt,
    arc=2.5pt,left=6pt,right=5.5pt,top=4pt,bottom=4pt,
    borderline north={2.1pt}{0pt}{#1},equal height group=kpigrp]
    \raggedright
    {\sffamily\bfseries\fontsize{12.6}{14.4}\selectfont\color{#1}#2}\par
    \vspace{1pt}
    {\sffamily\bfseries\fontsize{7.1}{8.5}\selectfont\color{ink}#3}\par
    \vspace{1pt}
    {\sffamily\fontsize{6.3}{7.8}\selectfont\color{sub}#4}
  \end{tcolorbox}%
}

% ---- Value / Play Card ------------------------------------------------------
\newcommand{\playcard}[4]{%
  \begin{tcolorbox}[enhanced,colback=surface,colframe=surface,boxrule=0pt,
    arc=2pt,left=6.5pt,right=6.5pt,top=4.5pt,bottom=4.5pt,
    borderline north={1.8pt}{0pt}{#2},equal height group=playgrp]
    \raggedright
    {\sffamily\bfseries\fontsize{6.4}{7.7}\selectfont\color{#2}\MakeUppercase{#1}}\par
    \vspace{1pt}
    {\sffamily\bfseries\fontsize{8.1}{9.7}\selectfont\color{ink}#3}\par
    \vspace{1.5pt}
    {\fontsize{7.65}{9.6}\selectfont\color{sub}#4}
  \end{tcolorbox}%
}

% ---- Callout & Governance Boxes ---------------------------------------------
\newtcolorbox{execbox}[2][accent]{enhanced,breakable=false,colback=surface,colframe=surface,
  boxrule=0pt,arc=1.5pt,left=7.5pt,right=7.5pt,top=4.8pt,bottom=4.8pt,
  borderline west={2.4pt}{0pt}{#1},before skip=3pt,after skip=2pt,
  fontupper=\fontsize{7.75}{9.7}\selectfont\raggedright,
  before upper={{\sffamily\bfseries\fontsize{6.8}{8.2}\selectfont\color{#1}\MakeUppercase{#2}}\par\vspace{1.8pt}\noindent\ignorespaces}}

\newtcolorbox{govbox}[1]{enhanced,breakable=false,colback=navytint,colframe=navy!30,
  boxrule=0.5pt,arc=2pt,left=7.5pt,right=7.5pt,top=4.8pt,bottom=4.8pt,
  borderline west={2.5pt}{0pt}{navy},before skip=0pt,after skip=2pt,
  fontupper=\fontsize{7.35}{9.3}\selectfont\color{ink}\raggedright,
  before upper={{\sffamily\bfseries\fontsize{7.0}{8.4}\selectfont\color{navy}\MakeUppercase{#1}}\par\vspace{2.2pt}\noindent\ignorespaces}}

\newtcolorbox{codecard}[1]{enhanced,breakable=false,colback=codebg,colframe=codebg,
  boxrule=0pt,arc=2.5pt,left=7.5pt,right=7.5pt,top=4.5pt,bottom=4.5pt,
  borderline north={2pt}{0pt}{accent},before skip=1pt,after skip=3pt,
  fontupper=\ttfamily\fontsize{6.45}{8.2}\selectfont\color{codefg}\raggedright,
  before upper={{\sffamily\bfseries\fontsize{6.6}{8.0}\selectfont\color{codeaccent}\MakeUppercase{#1}}\par\vspace{2.2pt}\noindent\ignorespaces}}

% ---- Chart styling ----------------------------------------------------------
\pgfdeclareverticalshading{tswash}{100bp}{%
  rgb(0bp)=(0.92,0.94,0.97);
  rgb(45bp)=(0.985,0.985,0.985);
  rgb(75bp)=(0.985,0.94,0.91);
  rgb(100bp)=(0.96,0.89,0.85)}

\pgfplotsset{briefhouse/.style={
  axis line style={draw=none},tick style={draw=none},
  tick label style={font=\sffamily\fontsize{6.3}{7.7}\selectfont,text=sub},
  label style={font=\sffamily\fontsize{6.7}{8.1}\selectfont,text=sub},
  grid style={draw=gridline,line width=0.45pt},clip=false}}

% ---- Numbered Step Badge ----------------------------------------------------
\newcommand{\stepbadge}[1]{%
  \tikz[baseline=(c.base)]\node[circle,fill=accent,text=white,inner sep=1.1pt,
    minimum size=11.5pt,font=\sffamily\bfseries\fontsize{7.0}{7.0}\selectfont] (c) {#1};%
}

% ---- Bottom CTA + QR Strip --------------------------------------------------
\newcommand{\brieffooterstrip}[3]{%
  \vfill
  \begin{tcolorbox}[enhanced,colback=surface,colframe=hair,boxrule=0.45pt,
    arc=2.5pt,left=8.5pt,right=7.5pt,top=4.2pt,bottom=4.2pt,
    borderline west={2.6pt}{0pt}{accent},before skip=2.5pt,after skip=0pt]
    \begin{minipage}[c]{0.84\linewidth}
      \raggedright
      {\sffamily\bfseries\fontsize{7.9}{9.5}\selectfont\color{ink}#1}\par
      \vspace{1.2pt}
      {\sffamily\fontsize{6.8}{8.9}\selectfont\color{sub}#2}
    \end{minipage}\hfill
    \begin{minipage}[c]{0.14\linewidth}
      \raggedleft
      \qrcode[height=0.84cm]{#3}\\[1.5pt]
      {\sffamily\fontsize{5.4}{6.5}\selectfont\color{sub}Scan for repo}
    \end{minipage}
  \end{tcolorbox}
}
